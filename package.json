{
  "name": "offer-calculator",
  "version": "1.0.0-complete",
  "description": "Offer Calculator — offline scientific calculator PWA + Capacitor (basic, scientific, memory, history, themes)",
  "private": true,
  "scripts": {
    "start": "npx --yes serve -l 4180 .",
    "serve": "npx --yes serve -l 4180 .",
    "start:py": "python3 -m http.server 4180",
    "build:web": "node scripts/build-web.js",
    "pack:windows": "node scripts/build-web.js",
    "smoke": "node scripts/smoke.js",
    "test": "node scripts/smoke.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "keywords": [
    "calculator",
    "scientific",
    "pwa",
    "offline",
    "capacitor"
  ],
  "author": "OfferPk / Mia Smith",
  "license": "MIT"
}
